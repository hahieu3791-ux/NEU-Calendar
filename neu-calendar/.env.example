# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=neu_calendar
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/neu_calendar

# App & Security
SECRET_KEY=neu-calendar-super-secret-key-change-in-production-2024
ENVIRONMENT=development

# LLM Provider Configuration
# Choose between: mock (default, no API key needed), gemini, openai, anthropic
LLM_PROVIDER=mock
LLM_MODEL=

# API Keys (optional if using mock)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Scheduler
ALERT_SCAN_INTERVAL_MINUTES=15
